HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# App: URL the browser uses to reach the frontend
FRONTEND_URL=http://localhost:3000

# Database — quick start (SQLite, no install). For PostgreSQL, switch the
# client and configure the DATABASE_* block below instead.
DATABASE_CLIENT=sqlite
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=imapsu
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=changeme

# Email — the app sends account-verification emails through nodemailer
# whenever SMTP_HOST is set (e.g. Gmail using an app password):
#   https://myaccount.google.com/apppasswords
# Leave SMTP_HOST empty to fall back to the local sendmail provider (dev only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=your16charapppassword
EMAIL_FROM=iMapSU <yourgmail@gmail.com>