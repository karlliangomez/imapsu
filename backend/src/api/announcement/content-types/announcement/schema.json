{
  "kind": "collectionType",
  "collectionName": "announcements",
  "info": {
    "singularName": "announcement",
    "pluralName": "announcements",
    "displayName": "Announcement"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "body": {
      "type": "text",
      "required": true
    },
    "audience": {
      "type": "enumeration",
      "default": "Everyone",
      "enum": [
        "Everyone",
        "Students",
        "Tenants"
      ]
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "publishAt": {
      "type": "datetime"
    },
    "expireAt": {
      "type": "datetime"
    },
    "acknowledgments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::announcement-acknowledgment.announcement-acknowledgment",
      "mappedBy": "announcement"
    }
  }
}
