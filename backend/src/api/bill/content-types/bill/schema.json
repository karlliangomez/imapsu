{
  "kind": "collectionType",
  "collectionName": "bills",
  "info": {
    "singularName": "bill",
    "pluralName": "bills",
    "displayName": "Bill"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "tenancy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenancy.tenancy",
      "inversedBy": "bills"
    },
    "period": {
      "type": "string"
    },
    "amount": {
      "type": "decimal",
      "required": true
    },
    "electricMeterPrevious": {
      "type": "decimal"
    },
    "electricMeterCurrent": {
      "type": "decimal"
    },
    "electricRate": {
      "type": "decimal"
    },
    "electricCharge": {
      "type": "decimal"
    },
    "waterMeterPrevious": {
      "type": "decimal"
    },
    "waterMeterCurrent": {
      "type": "decimal"
    },
    "waterRate": {
      "type": "decimal"
    },
    "waterCharge": {
      "type": "decimal"
    },
    "additionalCharges": {
      "type": "decimal",
      "default": 0
    },
    "dueDate": {
      "type": "date"
    },
    "status": {
      "type": "enumeration",
      "default": "Unpaid",
      "enum": [
        "Unpaid",
        "For Verification",
        "Verified",
        "Rejected",
        "Overdue"
      ]
    },
    "verificationNote": {
      "type": "text"
    },
    "paidAt": {
      "type": "datetime"
    },
    "orNumber": {
      "type": "string"
    },
    "receipt": {
      "type": "media",
      "multiple": false
    }
  }
}
