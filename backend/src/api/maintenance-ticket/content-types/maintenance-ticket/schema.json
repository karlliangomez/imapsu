{
  "kind": "collectionType",
  "collectionName": "maintenance_tickets",
  "info": {
    "singularName": "maintenance-ticket",
    "pluralName": "maintenance-tickets",
    "displayName": "Maintenance Ticket"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "reporter": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "propertySpace": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::property-space.property-space",
      "inversedBy": "maintenanceTickets"
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Plumbing",
        "Electrical",
        "Structural",
        "Internet",
        "Other"
      ]
    },
    "priority": {
      "type": "enumeration",
      "default": "Normal",
      "enum": [
        "Low",
        "Normal",
        "High",
        "Critical"
      ]
    },
    "description": {
      "type": "text",
      "required": true
    },
    "images": {
      "type": "media",
      "multiple": true
    },
    "status": {
      "type": "enumeration",
      "default": "Pending",
      "enum": [
        "Pending",
        "In Progress",
        "Completed"
      ]
    },
    "actionNotes": {
      "type": "text"
    },
    "completedAt": {
      "type": "datetime"
    },
    "followUps": {
      "type": "json"
    }
  }
}
