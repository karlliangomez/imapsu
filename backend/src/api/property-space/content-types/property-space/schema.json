{
  "kind": "collectionType",
  "collectionName": "property_spaces",
  "info": {
    "singularName": "property-space",
    "pluralName": "property-spaces",
    "displayName": "Property Space"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "propertyCode": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "building": {
      "type": "string",
      "required": true
    },
    "campus": {
      "type": "string"
    },
    "floor": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "area": {
      "type": "decimal"
    },
    "rentalClassification": {
      "type": "enumeration",
      "default": "Other",
      "enum": [
        "Food and Beverage",
        "Retail",
        "Services",
        "Office",
        "Storage",
        "Other"
      ]
    },
    "businessName": {
      "type": "string"
    },
    "photos": {
      "type": "media",
      "multiple": true
    },
    "productsServices": {
      "type": "text"
    },
    "operatingDetails": {
      "type": "text"
    },
    "space_status": {
      "type": "enumeration",
      "required": true,
      "default": "Vacant",
      "enum": [
        "Vacant",
        "Occupied"
      ]
    },
    "monthlyRent": {
      "type": "decimal"
    },
    "rentalApplications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::rental-application.rental-application",
      "mappedBy": "propertySpace"
    },
    "tenancies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tenancy.tenancy",
      "mappedBy": "propertySpace"
    },
    "feedbacks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::feedback.feedback",
      "mappedBy": "propertySpace"
    },
    "maintenanceTickets": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::maintenance-ticket.maintenance-ticket",
      "mappedBy": "propertySpace"
    },
    "mapZones": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::map-zone.map-zone",
      "mappedBy": "propertySpace"
    }
  }
}
